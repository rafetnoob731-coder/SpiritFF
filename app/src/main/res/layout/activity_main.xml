<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:text="SpiritFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#A78BFA"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="6 features · no root · Shizuku"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Permissions section -->
        <TextView android:id="@+id/tvPermOverlay"
            android:text="⬜ Overlay — tap to grant"
            android:textColor="#EF4444" android:textSize="14sp"
            android:padding="14dp" android:background="#1E1E2E"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tvPermStorage"
            android:text="⬜ Storage — tap to grant"
            android:textColor="#EF4444" android:textSize="14sp"
            android:padding="14dp" android:background="#1E1E2E"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tvPermShizuku"
            android:text="⬜ Shizuku — tap to grant"
            android:textColor="#EF4444" android:textSize="14sp"
            android:padding="14dp" android:background="#1E1E2E"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <!-- Status -->
        <TextView android:id="@+id/tvGameStatus"
            android:text="● Free Fire not detected"
            android:textColor="#F59E0B" android:textSize="13sp"
            android:padding="14dp" android:background="#1E1E2E"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <!-- Launch button -->
        <Button android:id="@+id/btnLaunch"
            android:text="Launch Floating Panel"
            android:textSize="16sp" android:textColor="#FFFFFF"
            android:backgroundTint="#7C3AED"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnStop"
            android:text="Stop Panel"
            android:textSize="14sp" android:textColor="#FFFFFF"
            android:backgroundTint="#EF4444"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
